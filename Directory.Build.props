<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CA1416: the whole app is Windows-only by design; the TFM already says so. -->
    <WarningsNotAsErrors>CA1416</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version Condition="'$(Version)' == ''">0.0.1</Version>

    <!-- Which of the two published shapes the exe projects build. Our own property rather
         than SelfContained itself, because the SDK does not carry SelfContained across a
         ProjectReference: publishing NoSilence.Console framework-dependent left the
         NoSilence.csproj it references self-contained, and the build failed with NETSDK1151.
         A property the SDK has never heard of flows down untouched. -->
    <NoSilenceSelfContained Condition="'$(NoSilenceSelfContained)' == ''">true</NoSilenceSelfContained>
    <Authors>ledrj</Authors>
    <Company>ledrj</Company>
    <Product>NoSilence</Product>
    <Copyright>Copyright © 2026 Jan Lédr</Copyright>
    <RepositoryUrl>https://github.com/BorderKeeper/NoSilence</RepositoryUrl>
  </PropertyGroup>

</Project>
